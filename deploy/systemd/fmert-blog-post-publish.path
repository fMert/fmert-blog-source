[Unit]
Description=fmert.me yönetim paneli yazı yayın kuyruğu

[Path]
PathExistsGlob=/opt/apps/fmert-blog/source/deploy/data/posts/.publish-jobs/*/request
PathExists=/opt/apps/fmert-blog/source/deploy/data/posts/.publish-trigger
Unit=fmert-blog-post-publish.service

[Install]
WantedBy=multi-user.target
